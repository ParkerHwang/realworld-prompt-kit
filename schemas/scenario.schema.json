{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ParkerHwang/realworld-prompt-kit/main/schemas/scenario.schema.json",
  "title": "RealWorld Prompt Kit v0.1 Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scenario_id",
    "revision",
    "status",
    "semantic_group_id",
    "title",
    "task",
    "coverage",
    "realizations",
    "evaluation",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "realworld-prompt-kit.scenario/0.1.0"},
    "scenario_id": {"type": "string", "pattern": "^rwpk\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "reviewed", "frozen", "retired"]},
    "semantic_group_id": {"type": "string", "pattern": "^rwpg\\.[a-z0-9_.]+$"},
    "title": {"$ref": "#/$defs/localized"},
    "task": {"$ref": "#/$defs/task"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "realizations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/realization"}
    },
    "evaluation": {"$ref": "#/$defs/evaluation"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en"],
      "properties": {
        "ko": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_intent", "secondary_intents", "primary_domain", "domain_tags", "user_goal", "expected_artifact"],
      "properties": {
        "primary_intent": {"type": "string", "enum": [
          "information_retrieval", "extraction_parsing", "summarization_synthesis", "transformation_rewriting", "explanation_teaching", "practical_writing", "creative_ideation", "classification_organization", "qualitative_analysis", "quantitative_formal_analysis", "diagnosis_root_cause", "forecasting_scenario_risk", "evaluation_review_audit", "decision_recommendation", "planning_strategy_design", "communication_collaboration_negotiation", "one_off_tool_execution", "automation_integration", "operations_monitoring_improvement", "coaching_conversational_support", "ai_agent_meta"
        ]},
        "secondary_intents": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true},
        "primary_domain": {"$ref": "#/$defs/domain"},
        "domain_tags": {"type": "array", "items": {"$ref": "#/$defs/domain"}, "uniqueItems": true},
        "user_goal": {"$ref": "#/$defs/localized"},
        "expected_artifact": {"type": "string", "minLength": 1}
      }
    },
    "domain": {"type": "string", "enum": [
      "general_knowledge", "office_admin", "communication_meetings", "project_product_management", "strategy_business_operations", "sales_marketing", "customer_support_success", "education_research", "personal_everyday", "software_it", "data_analytics", "creative_media", "health_care", "legal_compliance", "finance_accounting_tax", "hr_people_labor", "privacy_security", "government_public_policy", "safety_emergency", "manufacturing_quality", "supply_chain_logistics", "construction_real_estate", "energy_environment", "retail_ecommerce", "travel_hospitality", "science_rd", "nonprofit_social_impact", "agriculture_food"
    ]},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "row", "facets", "naturalistic_features"],
      "properties": {
        "block_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.cb8$"},
        "row": {"type": "integer", "minimum": 1, "maximum": 8},
        "facets": {"$ref": "#/$defs/facets"},
        "naturalistic_features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}, "uniqueItems": true}
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_scale", "goal_clarity", "output_shape", "evidence_state", "stakes", "interaction", "surface_noise"],
      "properties": {
        "context_scale": {"enum": ["short", "long"]},
        "goal_clarity": {"enum": ["explicit", "implicit"]},
        "output_shape": {"enum": ["prose", "structured"]},
        "evidence_state": {"enum": ["complete", "incomplete"]},
        "stakes": {"enum": ["low", "moderate"]},
        "interaction": {"enum": ["single", "message_burst"]},
        "surface_noise": {"enum": ["light", "heavy"]}
      }
    },
    "profile": {"type": "string", "enum": [
      "terse_fragment", "implicit_goal_or_output", "anaphora_prior_context", "missing_decisive_detail", "rambling_stream", "multi_intent_mixed_priority", "self_correction_scope_shift", "interleaved_instruction_and_paste", "typo_spacing_punctuation", "colloquial_slang_dialect", "code_switching_jargon", "speech_to_text_disfluency", "ocr_copy_format_noise", "emoji_shorthand", "message_burst", "followup_without_restatement", "mid_task_change", "resume_after_interruption", "indirect_polite_request", "frustration_urgency_emotion", "hedged_exploratory_request", "contradictory_constraints", "implicit_permission_or_authority", "untrusted_embedded_instruction"
    ]},
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["system", "developer", "user", "assistant", "tool"]},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "realization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "locale", "form", "origin", "features", "messages"],
      "properties": {
        "prompt_id": {"type": "string", "pattern": "^rwpk\\.[A-Za-z0-9_.-]+\\.(ko-KR|en-US)\\.(canonical|naturalistic)$"},
        "locale": {"enum": ["ko-KR", "en-US"]},
        "form": {"enum": ["canonical", "naturalistic"]},
        "origin": {"enum": ["controlled_canonical", "synthetic_naturalistic"]},
        "features": {"type": "array", "items": {"$ref": "#/$defs/profile"}, "uniqueItems": true},
        "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}}
      }
    },
    "response_mode": {"type": "string", "enum": ["answer_directly", "infer_and_answer", "state_assumptions_and_answer", "ask_one_clarifying_question", "clarification_dialogue", "hold", "refuse_or_escalate"]},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_mode", "invariants", "rubric_dimensions", "failure_signals"],
      "properties": {
        "response_mode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical", "naturalistic"],
          "properties": {"canonical": {"$ref": "#/$defs/response_mode"}, "naturalistic": {"$ref": "#/$defs/response_mode"}}
        },
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rubric_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true},
        "failure_signals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "authors", "contains_personal_data", "rights_basis", "license"],
      "properties": {
        "origin": {"const": "synthetic"},
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "contains_personal_data": {"const": false},
        "rights_basis": {"const": "original_project_authorship"},
        "license": {"const": "MIT"}
      }
    }
  }
}
