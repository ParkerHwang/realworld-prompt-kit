{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ParkerHwang/realworld-prompt-kit/main/schemas/artifact-contract.schema.json",
  "title": "RealWorld Prompt Kit v0.2 Artifact Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outputs",
    "side_effect_scope",
    "output_root",
    "preserve_input_assets"
  ],
  "properties": {
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "side_effect_scope": {
      "enum": [
        "read_only",
        "draft_only",
        "local_reversible_write"
      ]
    },
    "output_root": {
      "$ref": "#/$defs/relative_path"
    },
    "preserve_input_assets": {
      "const": true
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "type"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^check\\.[a-z][a-z0-9_]*$"
        },
        "type": {
          "enum": [
            "artifact_present",
            "bundle_exact_files",
            "contains_text",
            "json_keys",
            "media_type",
            "minimum_feature",
            "parseable",
            "reference_checks",
            "required_features",
            "required_sheet_names",
            "source_hashes_match"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "feature": {
          "$ref": "#/$defs/identifier"
        },
        "minimum": {
          "type": "integer",
          "minimum": 0
        },
        "case_sensitive": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_family",
        "media_type",
        "required",
        "editable",
        "filename",
        "required_features",
        "reference_path",
        "reference_sha256",
        "reference_checks"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_family": {
          "enum": [
            "response_only",
            "pdf_or_image",
            "document",
            "presentation",
            "spreadsheet",
            "mixed_bundle"
          ]
        },
        "media_type": {
          "enum": [
            "application/pdf",
            "application/json",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "text/csv",
            "text/plain"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "editable": {
          "type": "boolean"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.\\.?$)[^/\\\\]+$"
        },
        "required_features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "reference_path": {
          "$ref": "#/$defs/relative_path"
        },
        "reference_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    }
  }
}
