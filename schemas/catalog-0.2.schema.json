{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ParkerHwang/realworld-prompt-kit/main/schemas/catalog-0.2.schema.json",
  "title": "RealWorld Prompt Kit v0.2 Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "track",
    "description",
    "workflow_jobs",
    "modules",
    "artifact_families",
    "input_conditions",
    "interaction_patterns",
    "episodes"
  ],
  "properties": {
    "schema": {
      "const": "realworld-prompt-kit.catalog/0.2.0"
    },
    "version": {
      "const": "0.2.0"
    },
    "track": {
      "const": "artifact_core"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "workflow_jobs": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true
    },
    "modules": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id",
          "episode_count"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "minLength": 1
          },
          "episode_count": {
            "const": 2
          }
        }
      }
    },
    "artifact_families": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true
    },
    "input_conditions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true
    },
    "interaction_patterns": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true
    },
    "episodes": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "path",
          "module",
          "workflow_job",
          "primary_intent",
          "output_artifact_families"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^rwpk\\.[a-z0-9_.]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^data/v0\\.2/scenarios/[^/]+\\.json$"
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "workflow_job": {
            "type": "string",
            "minLength": 1
          },
          "primary_intent": {
            "type": "string",
            "minLength": 1
          },
          "output_artifact_families": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
