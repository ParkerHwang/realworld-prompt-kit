      "explicit",
      "implicit"
    ],
    "output_shape": [
      "prose",
      "structured"
    ],
    "evidence_state": [
      "complete",
      "incomplete"
    ],
    "stakes": [
      "low",
      "moderate"
    ],
    "interaction": [
      "single",
      "message_burst"
    ],
    "surface_noise": [
      "light",
      "heavy"
    ]
  },
  "license": "MIT",
  "source_policy": {
    "allowed_public_origins": [
      "controlled_canonical",
      "synthetic_naturalistic"
