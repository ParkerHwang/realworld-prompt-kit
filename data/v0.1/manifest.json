    "phrase_concentration": {
      "ngram_size": 6,
      "review_fraction": 0.05,
      "max_scenario_fraction": 0.05,
      "scope": "locale_and_form",
      "metric": "distinct-scenario presence count for exact six-token n-grams; every longer n-gram has a six-token prefix",
      "whitelist": []
    }
  },
  "source_policy": {
